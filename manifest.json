{
  "manifest_version": 3,
  "name": "DocFit - Image, PDF & File Spec Optimizer",
  "short_name": "DocFit",
  "version": "1.0.0",
  "description": "Fit any image, PDF, or HTML to exact portal requirements: target KB range, exact dimensions, DPI, and format. 100% offline & private.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open DocFit"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
